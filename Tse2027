                            <span class="text-xs text-cyan-400 font-medium flex items-center gap-1 mt-1">
                                63.8% of 176,846 total PUs
                            </span>
                        </div>
                        <div class="w-12 h-12 bg-cyan-500/10 rounded-xl flex items-center justify-center text-cyan-400 text-xl">
                            <i class="fa-solid fa-map-location-dot"></i>
                        </div>
                    </div>
                </div>

                <div class="glass-panel p-5 rounded-2xl relative overflow-hidden border-l-4 border-l-amber-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-mono text-slate-400 uppercase tracking-wider">Verified EC8A Sheets</p>
                            <h3 class="text-3xl font-black text-white mt-1 font-mono">48,219</h3>
                            <span class="text-xs text-amber-400 font-medium flex items-center gap-1 mt-1">
                                <i class="fa-solid fa-shield-check"></i> OCR Cross-Checked
                            </span>
                        </div>
                        <div class="w-12 h-12 bg-amber-500/10 rounded-xl flex items-center justify-center text-amber-400 text-xl">
                            <i class="fa-solid fa-file-circle-check"></i>
                        </div>
                    </div>
                </div>

                <div class="glass-panel p-5 rounded-2xl relative overflow-hidden border-l-4 border-l-rose-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-mono text-slate-400 uppercase tracking-wider">Flagged Discrepancies</p>
                            <h3 class="text-3xl font-black text-white mt-1 font-mono text-rose-400">142</h3>
                            <span class="text-xs text-rose-400/80 font-medium flex items-center gap-1 mt-1">
                                <i class="fa-solid fa-triangle-exclamation"></i> Under Review by Watchdogs
                            </span>
                        </div>
                        <div class="w-12 h-12 bg-rose-500/10 rounded-xl flex items-center justify-center text-rose-400 text-xl">
                            <i class="fa-solid fa-bug"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Presidential Tally Chart Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- Main National Vote Chart -->
                <div class="lg:col-span-2 glass-panel p-6 rounded-2xl border border-slate-800 space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-chart-column text-emerald-400"></i>
                                Presidential Exit Poll Standings (National Aggregate)
                            </h2>
                            <p class="text-xs text-slate-400 mt-0.5">Updated live from encrypted citizen submissions</p>
                        </div>
                        <button onclick="refreshTallyData()" class="self-start sm:self-auto px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 font-mono transition flex items-center gap-1.5">
                            <i class="fa-solid fa-rotate text-emerald-400" id="refresh-icon"></i> Refresh Feeds
                        </button>
                    </div>

                    <!-- Visual Progress Bar Breakdown -->
                    <div class="space-y-4 pt-2" id="party-progress-list">
