        <!-- ================= TAB 2: EXIT POLL SUBMISSION FORM ================= -->
        <section id="tab-exit-poll" class="tab-content hidden max-w-3xl mx-auto">
            <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-slate-800 space-y-6">
                
