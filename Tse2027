                    </div>

                    <!-- Canvas for Bar Chart Visualization -->
                    <div class="pt-4 h-64 relative">
                        <canvas id="presidentialChart"></canvas>
                    </div>
                </div>

                <!-- State & Regional Breakdown Selector -->
                <div class="glass-panel p-6 rounded-2xl border border-slate-800 space-y-5">
                    <div>
