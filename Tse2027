                    <div>
                        <label class="block text-xs font-mono text-slate-400 mb-2">SELECT NIGERIAN STATE</label>
                        <select id="state-dashboard-filter" onchange="updateStateBreakdown()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm font-medium text-white focus:outline-none focus:border-emerald-500 transition">
