                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1.5">State</label>
                                <select id="vote-state" required onchange="populateLGAs()" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 focus:outline-none">
                                    <option value="">Select State</option>
                                    <option value="Lagos">Lagos</option>
                                    <option value="Kano">Kano</option>
                                    <option value="Rivers">Rivers</option>
                                    <option value="Anambra">Anambra</option>
                                    <option value="FCT">FCT Abuja</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1.5">Local Government Area (LGA)</label>
                                <select id="vote-lga" required class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 focus:outline-none">
                                    <option value="">Select State First</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1.5">Polling Unit Code or Name</label>
                            <input type="text" id="vote-pu-code" placeholder="e.g. PU: 24-01-08-012 (Alausa Ward / Open Space)" required class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm text-white focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 focus:outline-none placeholder-slate-500 font-mono">
                        </div>
                    </div>

                    <!-- Party Choice Selection -->
                    <div class="space-y-4 pt-2">
                        <h3 class="text-sm font-bold text-emerald-400 font-mono uppercase tracking-wider flex items-center gap-2">
                            <span class="w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center text-xs">2</span> 
                            Select Party Voted For
                        </h3>

                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="party-selection-grid">
                            <!-- Party Buttons -->
                            <label class="cursor-pointer">
                                <input type="radio" name="party_choice" value="APC" required class="peer sr-only">
                                <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/60 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-white hover:bg-slate-800/80 transition flex items-center gap-3">
                                    <span class="w-7 h-7 rounded-lg bg-cyan-600 text-white font-black text-xs flex items-center justify-center">APC</span>
                                    <span class="font-bold text-sm">APC</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="party_choice" value="LP" class="peer sr-only">
                                <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/60 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-white hover:bg-slate-800/80 transition flex items-center gap-3">
                                    <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white font-black text-xs flex items-center justify-center">LP</span>
                                    <span class="font-bold text-sm">LP</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="party_choice" value="PDP" class="peer sr-only">
                                <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/60 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-white hover:bg-slate-800/80 transition flex items-center gap-3">
                                    <span class="w-7 h-7 rounded-lg bg-rose-600 text-white font-black text-xs flex items-center justify-center">PDP</span>
                                    <span class="font-bold text-sm">PDP</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="party_choice" value="NNPP" class="peer sr-only">
                                <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/60 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-white hover:bg-slate-800/80 transition flex items-center gap-3">
                                    <span class="w-7 h-7 rounded-lg bg-amber-600 text-white font-black text-xs flex items-center justify-center">NNPP</span>
                                    <span class="font-bold text-sm">NNPP</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="party_choice" value="APGA" class="peer sr-only">
                                <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/60 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-white hover:bg-slate-800/80 transition flex items-center gap-3">
                                    <span class="w-7 h-7 rounded-lg bg-purple-600 text-white font-black text-xs flex items-center justify-center">APGA</span>
                                    <span class="font-bold text-sm">APGA</span>
                                </div>
                            </label>

                            <label class="cursor-pointer">
                                <input type="radio" name="party_choice" value="OTHERS" class="peer sr-only">
                                <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-900/60 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-white hover:bg-slate-800/80 transition flex items-center gap-3">
                                    <span class="w-7 h-7 rounded-lg bg-slate-700 text-white font-black text-xs flex items-center justify-center">OTH</span>
                                    <span class="font-bold text-sm">Others</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Anti-Spam Security Shield Check -->
                    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-mono text-slate-300 flex items-center gap-1.5">
                                <i class="fa-solid fa-shield-cat text-cyan-400"></i> Sybil Defense & Bot Protection
                            </span>
                            <span class="text-[10px] bg-cyan-950 text-cyan-400 px-2 py-0.5 rounded font-mono border border-cyan-800">
                                Hardware Fingerprint Hash
                            </span>
                        </div>
                        
