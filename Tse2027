            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- ================= TAB 1: LIVE DASHBOARD ================= -->
        <section id="tab-dashboard" class="tab-content space-y-8">
            
            <!-- Hero Stats Row -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="glass-panel p-5 rounded-2xl relative overflow-hidden border-l-4 border-l-emerald-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-mono text-slate-400 uppercase tracking-wider">Total Tally Submissions</p>
                            <h3 class="text-3xl font-black text-white mt-1 font-mono" id="stat-total-votes">1,482,910</h3>
                            <span class="text-xs text-emerald-400 font-medium flex items-center gap-1 mt-1">
